# FloodTwin Responder Environment Configuration
PROJECT_NAME="FloodTwin Responder"
VERSION="1.0.0"
ENVIRONMENT="development"

# Safety Invariant: Must remain true in sandbox/demo environments
MOCK_NOTIFICATION_MODE=true

# Security Secrets (Do not commit production keys to version control)
SECRET_KEY="generate-a-secure-random-64-character-hex-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URLs
DATABASE_URL="sqlite:///./floodtwin.db"
# Production PostGIS: postgresql://floodtwin:floodtwin123@localhost:5432/floodtwin_db
REDIS_URL="redis://localhost:6379/0"

# Rate Limiting & Networking
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'

# Geographic Operational Envelope
DISTRICT_NAME="Chennai Metropolitan District"
DEFAULT_LAT=13.040
DEFAULT_LON=80.230
